### 修改三：数据库表设计（6.4节）

替换为以下设计：

```sql
-- 订单表（原始数据）
CREATE TABLE orders (
    order_id TEXT PRIMARY KEY,
    order_date DATE,
    customer_name TEXT,
    customer_segment TEXT,
    country TEXT,
    region TEXT,
    product_category TEXT,
    product_name TEXT,
    quantity INTEGER,
    unit_price REAL,
    discount_percent REAL,
    total_sales REAL,
    shipping_cost REAL,
    profit REAL,
    payment_method TEXT
);

-- 日销量聚合表（用于预测）
CREATE TABLE daily_sales (
    date DATE,
    category TEXT,
    quantity INTEGER,
    PRIMARY KEY (date, category)
);

-- 预测结果表
CREATE TABLE forecast_results (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    forecast_date DATE,
    category TEXT,
    horizon INTEGER,
    predicted_quantity REAL,
    model_version TEXT
);

-- 库存预警表
CREATE TABLE inventory_warnings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    category TEXT,
    current_stock REAL,
    forecast_7d REAL,
    safe_stock REAL,
    suggested_order REAL,
    warning_date DATE
);
```

